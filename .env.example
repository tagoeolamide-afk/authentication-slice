# SQLite database file, created by `npm run db:migrate`
DATABASE_URL="file:./dev.db"

PORT=3000
APP_URL="http://localhost:3000"

# outbox = (default) emails are printed in the terminal and saved in .mail-outbox/, nothing is sent
# smtp   = real delivery using the SMTP_* settings below
MAIL_TRANSPORT="outbox"
MAIL_FROM="shrink <no-reply@shrink.local>"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# 32+ random characters. Keys verification-code hashes and the pending-verification cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""
